 "caps": [
  {
   "t0": 0.02,
   "t1": 1.72,
   "text": "Nak ambil *lobak merah*, *goji*,"
  },
  {
   "t0": 1.72,
   "t1": 3.7,
   "text": "*avokado* dan juga *eyebright*"
  },
  {
   "t0": 3.7,
   "t1": 5.19,
   "text": "dalam makanan harian?"
  },
  {
   "t0": 5.19,
   "t1": 6.59,
   "text": "Saya ada *3 cara* senang."
  },
  {
   "t0": 6.59,
   "t1": 9.3,
   "text": "*Satu*, tumis lobak merah dengan sedikit minyak"
  },
  {
   "t0": 9.3,
   "t1": 10.88,
   "text": "*Karotenoid* larut dalam minyak"
  },
  {
   "t0": 10.88,
   "t1": 13.59,
   "text": "*Manual MSD* cakap ia paling baik diserap"
  },
  {
   "t0": 13.59,
   "t1": 17.19,
   "text": "daripada sayur yang dimasak dengan sedikit lemak ataupun minyak"
  },
  {
   "t0": 17.19,
   "t1": 19.39,
   "text": "*Kedua*, letak goji dalam sup"
  },
  {
   "t0": 19.39,
   "t1": 20.63,
   "text": "secara tradisional"
  },
  {
   "t0": 20.63,
   "t1": 23.44,
   "text": "Goji memang dah pernah dimasak dalam sup"
  },
  {
   "t0": 23.44,
   "t1": 28.11,
   "text": "tapi banyak diamalkan di China ataupun dibuat sebagai *teh herba*"
  },
  {
   "t0": 28.11,
   "t1": 32.63,
   "text": "*Yang ketiga*, kita ada sisip avokado sebagai lemak baik"
  },
  {
   "t0": 32.63,
   "t1": 36.12,
   "text": "*Berita Harian* tulis, avokado bantu serap lemak larut"
  },
  {
   "t0": 36.12,
   "t1": 38.86,
   "text": "dalam Berita Harian around 2019 macam itu"
  },
  {
   "t0": 38.86,
   "t1": 42.39,
   "text": "*Tapi ingat*, makanan cukup dan pemeriksaan mata"
  },
  {
   "t0": 42.39,
   "t1": 44.09,
   "text": "berkala tetap asas"
  },
  {
   "t0": 44.09,
   "t1": 47.16,
   "text": "Pakar syor pemeriksaan mata asas"
  },
  {
   "t0": 47.16,
   "t1": 49.78,
   "text": "bila umur dah meningkat *40 tahun*"
  },
  {
   "t0": 49.78,
   "t1": 52.76,
   "text": "Kalau nak sokongan harian tambahan"
  },
  {
   "t0": 52.76,
   "t1": 55.08,
   "text": "ada *DS Pharma Eye Care*"
  },
  {
   "t0": 55.08,
   "t1": 56.59,
   "text": "Ada *eyebright* juga,"
  },
  {
   "t0": 56.59,
   "t1": 60.2,
   "text": "bunga Eropah yang digunakan secara tradisional untuk mata"
  },
  {
   "t0": 60.2,
   "t1": 61.49,
   "text": "*Berdaftar* dengan MAL22076147T"
  },
  {
   "t0": 61.49,
   "t1": 64.87,
   "text": "digunakan secara tradisional untuk kesihatan mata"
  },
  {
   "t0": 64.87,
   "t1": 67.1,
   "text": "Jadi kalau nak dapatkan ni, boleh tengok dekat *profil*"
  },
  {
   "t0": 67.1,
   "t1": 68.42,
   "text": "ataupun cek *beg kuning* sekarang"
  }
 ],
